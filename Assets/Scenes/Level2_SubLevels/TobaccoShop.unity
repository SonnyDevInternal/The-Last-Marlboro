  owningTalkCamera: {fileID: 1641506369}
  canvas: {fileID: 1042380990}
  talkUIBar: {fileID: 735176364}
  talkText: {fileID: 634396099}
  textShowers:
  - text: Ayyy whats good sir
    textStepTime: 0.2
    textPauseTime: 1
  - text: Ohhh your the Human Dude
    textStepTime: 0.2
    textPauseTime: 2
  - text: You want my Key right?
    textStepTime: 0.2
    textPauseTime: 1
  - text: Okay heres the Deal
    textStepTime: 0.2
    textPauseTime: 1
  - text: I have a Customer Problem since our Tobacco ran out
    textStepTime: 0.2
    textPauseTime: 1
  - text: Luckily most people also like the Alien Tobacco
    textStepTime: 0.2
    textPauseTime: 1
  - text: Its lazed with some Alien Chemicals
    textStepTime: 0.1
    textPauseTime: 1
  - text: Uhhh i think its called uhhhh
    textStepTime: 0.4
    textPauseTime: 3
  - text: Im getting off Topic
    textStepTime: 0.1
    textPauseTime: 1
  - text: Fight these Goons that are scaring my Customers
    textStepTime: 0.1
    textPauseTime: 1
  - text: And i will give you the Key!
    textStepTime: 0.1
    textPauseTime: 1
